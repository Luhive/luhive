DATABASE_URL=postgresql://user:password@host:6543/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_POOL_MAX=5

# Optional. Unset means no Application Insights export and no OpenTelemetry
# provider; pino still logs to stdout. Set in Container Apps from Key Vault.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Required by `pnpm test:db` only. The disposable validation project, never
# production — the same connection string packages/db migrates against.
# VALIDATION_DATABASE_URL=postgresql://user:password@validation-host:5432/postgres
